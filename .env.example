HOST=127.0.0.1
PORT=8788

# Production ChatGPT access: OAuth 2.1 Authorization Code + PKCE S256.
UNIFIED_MCP_OAUTH_ENABLED=0
UNIFIED_MCP_BASE_URL=https://mcp.example.com
UNIFIED_MCP_ADMIN_SECRET=
UNIFIED_MCP_JWT_SECRET=
UNIFIED_MCP_STATE_FILE=/var/lib/unified-mcp-gateway/oauth-state.json
UNIFIED_MCP_OAUTH_REDIRECT_HOSTS=chatgpt.com
UNIFIED_MCP_OAUTH_ALLOW_LEGACY_REDIRECT=0

# Direct/private clients only when OAuth is disabled.
UNIFIED_MCP_HTTP_BEARER_TOKEN=
UNIFIED_MCP_DEV_NOAUTH=0
UNIFIED_MCP_CORS_ORIGIN=

# Consequential actions fail closed unless explicitly enabled.
UNIFIED_MCP_ALLOW_WRITE=0
UNIFIED_MCP_ALLOW_HIGH_RISK=0
UNIFIED_MCP_ALLOW_DESTRUCTIVE=0
UNIFIED_MCP_ALLOW_PRODUCTION=0

# GitHub provider. No repository is allowed by default.
UNIFIED_MCP_GITHUB_TOKEN=
UNIFIED_MCP_GITHUB_REPOSITORIES=

# Meta Graph API provider is read-only in the current native adapter.
UNIFIED_MCP_META_TOKEN=
UNIFIED_MCP_META_GRAPH_VERSION=
UNIFIED_MCP_META_APP_ID=
UNIFIED_MCP_META_WABA_ID=

# Generic downstream MCP composition.
UNIFIED_MCP_DOWNSTREAM_ALLOWED_HOSTS=
# Example: [{"id":"google","url":"https://mcp.example.com/mcp","tokenEnv":"GOOGLE_MCP_TOKEN","allowedTools":["search"],"riskOverrides":{"search":"READ"}}]
UNIFIED_MCP_DOWNSTREAM_JSON=[]
