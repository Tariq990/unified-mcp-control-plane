HOST=127.0.0.1
PORT=8788

# Production ChatGPT access: OAuth 2.1 Authorization Code + PKCE S256.
# Legacy RECEPIO_MCP_* names are intentionally preserved in the first standalone extraction
# so the tested runtime behavior is unchanged. They can be migrated with compatibility aliases later.
RECEPIO_MCP_OAUTH_ENABLED=0
RECEPIO_MCP_BASE_URL=https://mcp.example.com
RECEPIO_MCP_ADMIN_SECRET=
RECEPIO_MCP_JWT_SECRET=
RECEPIO_MCP_STATE_FILE=/var/lib/unified-mcp-gateway/oauth-state.json
RECEPIO_MCP_OAUTH_REDIRECT_HOSTS=chatgpt.com
RECEPIO_MCP_OAUTH_ALLOW_LEGACY_REDIRECT=0

# Direct/private clients only when OAuth is disabled.
RECEPIO_MCP_HTTP_BEARER_TOKEN=
RECEPIO_MCP_DEV_NOAUTH=0
RECEPIO_MCP_CORS_ORIGIN=

# Consequential actions fail closed unless explicitly enabled.
RECEPIO_MCP_ALLOW_WRITE=0
RECEPIO_MCP_ALLOW_HIGH_RISK=0
RECEPIO_MCP_ALLOW_DESTRUCTIVE=0
RECEPIO_MCP_ALLOW_PRODUCTION=0

# GitHub provider.
RECEPIO_MCP_GITHUB_TOKEN=
RECEPIO_MCP_GITHUB_REPOSITORIES=Tariq990/unified-mcp-gateway
RECEPIO_MCP_GITHUB_CONTROL_REPOSITORY=Tariq990/unified-mcp-gateway
RECEPIO_MCP_GITHUB_CONTROL_BRANCH=ops/github-control
RECEPIO_MCP_GITHUB_CONTROL_PATH=.recepio/github-control-request.json

# Meta Graph API v0.1 is read-only. Configure only the assets you want this gateway to expose.
RECEPIO_MCP_META_TOKEN=
RECEPIO_MCP_META_GRAPH_VERSION=
RECEPIO_MCP_META_APP_ID=
RECEPIO_MCP_META_WABA_ID=

# Generic downstream MCP composition.
RECEPIO_MCP_DOWNSTREAM_ALLOWED_HOSTS=
# Example: [{"id":"google","url":"https://mcp.example.com/mcp","tokenEnv":"GOOGLE_MCP_TOKEN","allowedTools":["search"],"riskOverrides":{"search":"READ"}}]
RECEPIO_MCP_DOWNSTREAM_JSON=[]
