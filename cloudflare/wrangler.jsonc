{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unified-mcp-gateway",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "vars": {
    "UNIFIED_MCP_ALLOW_WRITE": "1",
    "UNIFIED_MCP_ALLOW_HIGH_RISK": "1",
    "UNIFIED_MCP_ALLOW_DESTRUCTIVE": "1",
    "UNIFIED_MCP_ALLOW_PRODUCTION": "1",
    "UNIFIED_MCP_GITHUB_REPOSITORIES": "Tariq990/unified-mcp-gateway",
    "UNIFIED_MCP_DOWNSTREAM_ALLOWED_HOSTS": "",
    "UNIFIED_MCP_DOWNSTREAM_JSON": "[]"
  }
}
